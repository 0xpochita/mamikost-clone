BIOME="./node_modules/.bin/biome"

"$BIOME" check --staged --no-errors-on-unmatched || exit 1

# husky runs hooks through `sh -e`, so any command that legitimately exits
# non-zero aborts the hook with no output. grep returns 1 when it finds
# nothing, which is the success case here, hence every `|| true`.
staged_files() {
  git diff --cached --name-only --diff-filter=ACM -- "$@" || true
}

scan_files() {
  printf '%s\n' "$2" | tr '\n' '\0' | xargs -0 grep -nE "$1" 2>/dev/null || true
}

TEXT_FILES=$(staged_files '*.ts' '*.tsx' '*.css' '*.md' '*.mjs' '*.json')
if [ -n "$TEXT_FILES" ]; then
  EM_DASH=$(scan_files '—' "$TEXT_FILES")
  if [ -n "$EM_DASH" ]; then
    echo "blocked: em-dash character found (rules section 3)."
    echo "use a hyphen, a colon, or parentheses instead."
    printf '%s\n' "$EM_DASH"
    exit 1
  fi
fi

ASSETS_CONFIG="src/config/assets.ts"

# Resolves `${ASSET_PATHS.key}/file` by reading the key to folder map straight
# out of the config, so the hook cannot drift from it.
resolve_asset_key() {
  sed -n "s|^[[:space:]]*$1:[[:space:]]*\`\${IMAGE_ROOT}/\([A-Za-z0-9_-]*\)\`.*|\1|p" \
    "$ASSETS_CONFIG" 2>/dev/null | head -1
}

SOURCE_FILES=$(staged_files '*.ts' '*.tsx')
if [ -n "$SOURCE_FILES" ]; then
  MISSING=""

  for ASSET in $(scan_files '"/img/[^"]+"' "$SOURCE_FILES" |
    grep -oE '"/img/[^"]+"' | tr -d '"' | sort -u); do
    [ -f "public$ASSET" ] || MISSING="$MISSING$ASSET
"
  done

  for REF in $(scan_files 'ASSET_PATHS\.[a-z]+\}/[^\`"]+' "$SOURCE_FILES" |
    grep -oE 'ASSET_PATHS\.[a-z]+\}/[^`"]+' | sort -u); do
    KEY=${REF#ASSET_PATHS.}
    KEY=${KEY%%\}*}
    FILE=${REF#*\}/}
    FOLDER=$(resolve_asset_key "$KEY")
    if [ -z "$FOLDER" ]; then
      MISSING="$MISSING(unknown ASSET_PATHS key) $KEY
"
    elif [ ! -f "public/img/$FOLDER/$FILE" ]; then
      MISSING="$MISSING/img/$FOLDER/$FILE
"
    fi
  done

  if [ -n "$MISSING" ]; then
    echo "blocked: source references a public asset that is not on disk."
    echo "a path under public/ is only a string, so the type checker cannot see this."
    printf '%s' "$MISSING"
    exit 1
  fi
fi

COMPONENT_FILES=$(staged_files '*.tsx')
if [ -n "$COMPONENT_FILES" ]; then
  # Comment lines are excluded on purpose. Section 5 allows a comment that
  # records where a value came from, and a guard that forces accurate
  # documentation to be deleted is worse than no guard.
  HEX=$(scan_files '#[0-9a-fA-F]{6}([^0-9a-fA-F]|$)' "$COMPONENT_FILES" |
    grep -vE '(^|:)[0-9]+: *[{]?(//|/\*|\*)' || true)
  if [ -n "$HEX" ]; then
    echo "blocked: hex colour literal outside globals.css (rules section 6)."
    echo "define it as a token in globals.css and use the utility class."
    printf '%s\n' "$HEX"
    exit 1
  fi
fi

exit 0
